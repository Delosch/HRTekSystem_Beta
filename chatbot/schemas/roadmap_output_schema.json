{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HR Digital Roadmap Output Schema",
  "type": "object",
  "required": [
    "roadmap_id",
    "generated_on",
    "time_horizon",
    "prioritization_method",
    "initiatives"
  ],
  "properties": {
    "roadmap_id": {
      "type": "string",
      "description": "Unique identifier for the generated roadmap"
    },
    "generated_on": {
      "type": "string",
      "format": "date",
      "description": "Date the roadmap was generated"
    },
    "time_horizon": {
      "type": "string",
      "description": "Overall roadmap horizon (e.g., 12-24 months)"
    },
    "prioritization_method": {
      "type": "string",
      "enum": ["impact_vs_readiness", "quick_wins_vs_long_term"],
      "description": "Logic used to prioritize initiatives"
    },
    "initiatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "initiative_id",
          "title",
          "category",
          "priority",
          "phase",
          "rationale"
        ],
        "properties": {
          "initiative_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "Foundational",
              "Tactical",
              "Strategic",
              "Innovative"
            ]
          },
          "priority": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "phase": {
            "type": "string",
            "enum": [
              "0-6 months",
              "6-12 months",
              "12-24 months"
            ]
          },
          "rationale": {
            "type": "string",
            "description": "Why this initiative was recommended and prioritized"
          }
        }
      }
    }
  }
}
